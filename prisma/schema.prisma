generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Status/type fields were kept as plain Strings (not native enums) back when
// this ran on SQLite, which has no enum support. Left as-is after the
// Postgres migration to avoid an unrelated schema churn — valid values are
// documented inline as comments and enforced in application code.

model Employee {
  id                           String    @id @default(cuid())
  fullName                     String
  intuitEmail                  String?
  phoneNumber                  String?
  employeeType                 String? // FTE | CW | OSP | Intern (Intern follows CW/OSP rules everywhere except intake detection)
  jobTitle                     String? // free-text role/title; if it contains "Intern" at intake, employeeType is forced to "Intern"
  managerName                  String?
  managerEmail                 String?
  employmentStartDate          DateTime?
  employmentEndDate            DateTime?
  status                       String    @default("PENDING_START") // NEW_HIRE | PENDING_START | ACTIVE | OFFBOARDING | OFFBOARDED — NEW_HIRE is auto-set when a New Hire ServiceNow ticket creates this record before manual intake happens
  businessUnitDirectorApproved Boolean   @default(false)
  hardwareReminderSent         Boolean   @default(false)
  welcomeLinksSent             Boolean   @default(false)
  orientationInviteSent        Boolean   @default(false)
  offboardMilestonesSent       String? // comma-separated day-offsets already sent, e.g. "21,14"

  assets         Asset[]
  mobileDevices  MobileDevice[]
  lineForms      LineForm[]
  notifications  Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Asset {
  id                  String    @id @default(cuid())
  employeeId          String
  employee            Employee  @relation(fields: [employeeId], references: [id])
  computerType        String? // MACBOOK_PRO_14 | MACBOOK_PRO_16 | LENOVO_T14 | LENOVO_P1 | null (imported, doesn't fit)
  model               String? // free-text model, e.g. "MacBook M4 Max (16\" 64GB)"
  assetTag            String
  assignedDate        DateTime
  status              String    @default("ASSIGNED") // ASSIGNED | RETURN_REQUESTED | RETURNED
  refreshEligibleDate DateTime?
  refreshStatus       String    @default("NOT_ELIGIBLE") // NOT_ELIGIBLE | ELIGIBLE_AWAITING_ACTION | COMPLETED
  refreshNotifiedAt   DateTime?
  lastReminderSentAt  DateTime?
  returnedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MobileDevice {
  id                  String    @id @default(cuid())
  employeeId          String
  employee            Employee  @relation(fields: [employeeId], references: [id])
  phoneNumber         String?
  model               String? // free-text model, e.g. "iPhone 16 Pro Max"
  assetTag            String?
  simNumber           String?
  status              String    @default("NOT_APPLICABLE") // NOT_APPLICABLE | PENDING_APPROVAL | ASSIGNED | RETURN_REQUESTED | BUYBACK_REQUESTED | RETURNED | BOUGHT_BACK | PORTED_OUT | DISCONNECTED
  assignedDate        DateTime?
  refreshEligibleDate DateTime?
  refreshStatus       String    @default("NOT_ELIGIBLE") // NOT_ELIGIBLE | ELIGIBLE_AWAITING_ACTION | COMPLETED
  refreshNotifiedAt   DateTime?
  lastReminderSentAt  DateTime?
  resolvedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LineForm {
  id                  String    @id @default(cuid())
  employeeId          String
  employee            Employee  @relation(fields: [employeeId], references: [id])
  formType            String // INCOMING_TRANSFER | PORT_IN | TAKE_PRIVATE_OWNERSHIP
  status              String    @default("NOT_STARTED") // NOT_STARTED | SENT_TO_EMPLOYEE | EMPLOYEE_COMPLETED | SENT_TO_PARTNER | VOICEBOT_APPROVED (PORT_IN only, terminal)
  phoneNumber         String?
  sentToEmployeeAt    DateTime?
  employeeCompletedAt DateTime?
  sentToPartnerAt     DateTime?
  voicebotApprovedAt  DateTime? // PORT_IN only: user called 1800-054-005 and confirmed the voicebot approval
  notes               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id          String    @id @default(cuid())
  channel     String // EMAIL | SLACK | CALENDAR
  toAddress   String
  ccAddresses String?
  subject     String?
  body        String
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id])
  triggerType String
  status      String    @default("SIMULATED") // SIMULATED | SENT

  createdAt DateTime @default(now())
}

// Snapshot of ServiceNow incidents for the 3 T4i TLV ticket queues Roy tracks.
// This is NOT live — the ServiceNow connector is only reachable from an
// interactive Claude session, not from this deployed app, so these rows are
// refreshed by re-running scripts/import-tickets.ts on request.
model Ticket {
  id               String    @id @default(cuid())
  number           String    @unique // ServiceNow INC number
  category         String // MOBILE_BUYBACK | MOBILE_DEVICE_REQUEST | NEW_HIRE
  shortDescription String
  description      String?
  callerName       String?
  assignmentGroup  String?
  priority         String?
  state            String // raw ServiceNow state code, e.g. "2", "-5", "7" — see TICKET_STATE_LABELS
  startDate        DateTime? // NEW_HIRE only — the new hire's start date, parsed from the RITM's "Start Date" field
  newHireName      String? // NEW_HIRE only — the new hire's name, parsed from the RITM description's "New Hire: <Name>" field; used to auto-create an Employee record
  snowSysId        String?
  snowCreatedAt    DateTime?
  snowClosedAt     DateTime?

  // MOBILE_DEVICE_REQUEST only, parsed from the RITM description's "Who is
  // this request for?" / "Employee Email" / "Choose your preferred model" /
  // "Select Request Type" fields.
  requesterName  String?
  requesterEmail String?
  requesterPhone String? // when available (e.g. the port-in flow's "current number"); used to autofill the partner-*-form links
  deviceType     String?
  requestType    String? // "New Request" | "Refresh Request"

  // MOBILE_DEVICE_REQUEST only. Filled in manually (editable on /tickets)
  // once the physical SIM is known — needed for the "new line" Partner email
  // when the delivered-device Slack flow's employee picks that option.
  simNumber String?

  // MOBILE_DEVICE_REQUEST only. Set the first time the daily job sees this
  // ticket, right after the "order received" Slack ack is sent — guards
  // against re-sending on every subsequent daily run.
  orderReceivedNotifiedAt DateTime?

  // Set when Roy checks "Delivered" on a MOBILE_DEVICE_REQUEST row.
  // deliveredNotifiedAt guards against re-sending the line-setup Slack
  // message if the checkbox is toggled more than once.
  delivered           Boolean   @default(false)
  deliveredNotifiedAt DateTime?

  // Set from the Slack interactive dropdown once the employee responds.
  lineOptionChosen   String? // PARTNER | NON_PARTNER | NEW_LINE
  lineOptionChosenAt DateTime?

  // PORT_IN flow only. Set when the employee submits the port-in form
  // (triggers a Slack "call 1-800-054-005" reminder with a Done button);
  // portInCallConfirmedAt guards against emailing Partner twice if Done is
  // pressed more than once.
  portInFormSubmittedAt DateTime?
  portInCallConfirmedAt DateTime?

  // All tickets. Free-text home address used by the two shipping-coordination
  // checkboxes below to DM Daniela Puker, Yanit Levy, and Jacky Yatzik.
  // The *RequestedAt fields guard against re-sending if a checkbox is
  // toggled more than once — they're one-way, like `delivered` above.
  homeAddress            String?
  shipHomeRequestedAt    DateTime?
  shipToOfficeRequestedAt DateTime?

  importedAt DateTime @default(now())
}
